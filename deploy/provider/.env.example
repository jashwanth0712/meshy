# Public hostname of the provider. An IP-based sslip.io name works out of the
# box: 16.4.10.3 -> 16-4-10-3.sslip.io (meshy-sync is served at sync.<domain>).
NB_DOMAIN=16-4-10-3.sslip.io

# Filled in by bootstrap.sh (NetBird /api/setup with create_pat). Keep secret.
NETBIRD_TOKEN=

# Orgs whose ENS state this provider enforces on the mesh.
MESHY_ORGS=meshydemo.eth
# This provider's id in ProviderRegistry (signer = attestor key) and the
# subscription contract used for seat checks.
MESHY_PROVIDER_ID=1
MESHY_SUBSCRIPTION=0x83989608D93858c1D835216B44B44469Dc8204Df
MESHY_PROVIDER_REGISTRY=0x8B93557b315E825C657D48A4CB962A3fF7E4eEec

# Sepolia RPC. Must allow wide eth_getLogs ranges (Alchemy free tier caps at 10 blocks).
MESHY_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com

# Dashboard origins allowed by CORS (comma separated).
MESHY_CORS=http://localhost:3000

# World ID Agent Pass (confidential client). Leave empty to disable.
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
MESHY_WORLD_ISSUER=https://sandbox.auth.world.org
