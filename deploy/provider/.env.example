# NetBird configuration
NB_DOMAIN=mesh.example.com
LETSENCRYPT_EMAIL=admin@example.com
NB_OIDC_DISCOVERY=https://accounts.google.com/.well-known/openid-configuration
NB_AUTH_CLIENT_ID=your-oidc-client-id
NB_AUTH_AUDIENCE=your-oidc-audience
NB_PAT=  # fill after bootstrap

# Meshy provider
MESHY_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# World ID (get from https://developer.worldcoin.org)
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
MESHY_WORLD_ISSUER=https://sandbox.auth.world.org

# Dashboard CORS
MESHY_CORS=http://localhost:3000

# Set true while World sandbox credentials are pending (demo use only)
MESHY_DEV_ATTEST=false
